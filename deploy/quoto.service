[Unit]
Description=Quoto Telegram bot
# Wait for real connectivity, not just for an interface to exist.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quoto
Group=quoto
WorkingDirectory=/opt/quoto
# The bot reads .env itself from the working directory, so no EnvironmentFile:
# systemd's parser would choke on quoting that python-dotenv handles fine.
ExecStart=/opt/quoto/.venv/bin/python bot.py

# Telegram drops long-poll connections routinely; always come back.
Restart=always
RestartSec=5
# A stop goes to the bot alone, which finishes the request in hand before
# exiting; the ffmpeg it started are only killed if it has not after 30s.
# Sending the stop to every process at once cut renders off mid-frame.
KillMode=mixed
TimeoutStopSec=30

# --- What the bot may write: its state and its log, and nothing else.
# /opt/quoto (the code, the venv, .env) belongs to root and is read-only to
# the bot. A process that can rewrite its own source, or the pickle it loads
# at startup, turns any one bug into a foothold that survives restarts.
StateDirectory=quoto
StateDirectoryMode=0700
Environment=STATE_DIR=/var/lib/quoto
# Bytecode for the read-only code is compiled at deploy time, not here.
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077

# --- How much it may use. Two cores and 2 GB: a runaway render, a picture
# built to be expensive, or a flood of requests takes the bot down - not ssh,
# not the rest of the machine.
MemoryMax=1200M
MemorySwapMax=0
CPUQuota=170%
TasksMax=128

# --- Everything else it has no business touching.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A refused call fails with an error the library can handle, rather than
# killing the bot outright in the middle of somebody's render.
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

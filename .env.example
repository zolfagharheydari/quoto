# توکنی که @BotFather بهت می‌دهد
BOT_TOKEN=123456:ABC-your-token-here

# متن کوچکی که گوشه پایین-راست عکس نوشته می‌شود (خالی بگذار تا نوشته نشود)
WATERMARK=@YourBotUsername

# اگر تلگرام مستقیم باز نمی‌شود، آدرس پروکسی را اینجا بگذار.
# مثال: socks5://127.0.0.1:1080  یا  http://127.0.0.1:8080
# خالی بگذار تا بدون پروکسی وصل شود.
PROXY=

# اختیاری: آی‌دی چتی که عکس‌های حالت inline موقتاً آنجا آپلود می‌شوند.
# یک کانال خصوصی بساز، ربات را ادمینش کن و آی‌دی‌اش را اینجا بگذار (مثل -1001234567890).
# خالی که باشد، از چت خصوصی خود کاربر استفاده می‌شود و پیام بلافاصله پاک می‌شود.
# A numeric id (-1001234567890) or an @name. Not an invite link: a bot
# cannot follow one. Easier still, leave it empty and make the bot an admin
# of a private channel - it keeps the id itself.
STORAGE_CHAT_ID=

# اختیاری: آی‌دی عددی خودت. فقط همین آی‌دی می‌تواند /debug را اجرا کند.
# اگر خالی باشد، /debug برای هیچ‌کس کار نمی‌کند؛ یک بار بفرستش و آی‌دی را
# از پنجره‌ی ربات بردار و اینجا بگذار.
OWNER_ID=

# منطقه‌ی زمانی ساعتی که روی اسکرین‌شات نوشته می‌شود.
# خالی که باشد UTC است. مثال: Asia/Tehran
TIMEZONE=

# People must be in this channel to use the bot - where you announce things.
# The bot has to be an ADMIN of it, or it cannot see who is in it (and then
# it lets everyone through rather than locking them all out).
# This is not the storage channel; keep them separate.
REQUIRED_CHANNEL=
